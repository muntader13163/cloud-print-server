{
  "name": "سيرفر الطباعة السحابي - CloudPrint",
  "short_name": "CloudPrint",
  "description": "نظام طباعة سحابي متكامل لإدارة وطباعة المستندات عن بُعد",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0f172a",
  "theme_color": "#2563eb",
  "icons": [
    {
      "src": "https://cdn-icons-png.flaticon.com/512/2936/2936757.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "name",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": ["application/pdf", "image/*"]
        }
      ]
    }
  }
}